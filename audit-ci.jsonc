{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // audit-ci supports reading JSON, JSONC, and JSON5 config files.
  // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
  "moderate": true,
  "allowlist": [ // NOTE": Please add as much information as possible to any items added to the allowList
    "GHSA-rpr9-rxv7-x643", // XSS vulnerability in central-services-shared/shins/sanitize-html. No fix currently available.
    "GHSA-6v5v-wf23-fmfq", // Quadratic complexity DoS in smartquotes rule via replaceAt string operations. No fix for 12.X.X versions available.
    "GHSA-f23m-r3pf-42rh", // lodash vulnerable to Prototype Pollution. This is already overriden but still seems to be getting flagged here.
    "GHSA-r5fr-rjxr-66jc", // lodash vulnerable to Code Injection. This is already overriden but still seems to be getting flagged here.
    "GHSA-xxjr-mmjv-4gpg", // Lodash has Prototype Pollution Vulnerability. This is already overriden but still seems to be getting flagged here.
    "GHSA-h67p-54hq-rp68", // js-yaml, can't override without breaking unit tests.
    "GHSA-mh99-v99m-4gvg"  // brace-expansion, can't override without breaking unit tests.
  ]
}
